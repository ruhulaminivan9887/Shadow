PORT=3002
BASE_URL=https://your-app.onrender.com

# Accounts + database. Create a NEW Supabase project (separate from PentScribe/SentraMap).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ADMIN_EMAIL=ruhulaminivan@gmail.com

# AI governance briefing. console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# Google Workspace OAuth. console.cloud.google.com -> Credentials -> OAuth Client ID (Web)
# Authorized redirect URI: {BASE_URL}/auth/google/callback
