GOOGLE_CLIENT_SECRET=

# Microsoft 365 OAuth. portal.azure.com -> App registrations -> New registration
# Redirect URI: {BASE_URL}/auth/microsoft/callback
# API permissions needed (admin consent required): Application.Read.All, Directory.Read.All
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Payments
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
